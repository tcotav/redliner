__pycache__/
*.pyc
.venv/
venv/
.env
*.egg-info/
.DS_Store
.pytest_cache/
.ruff_cache/

# Per-run output is regenerable; the brief and phase state (state.json)
# are not, and belong with the manuscript they describe. Unanchored (**/)
# so this matches under any manuscript directory, not just the repo root.
**/.redliner/findings/
**/.redliner/canon/

# Downloaded by hooks/bootstrap-redliner-binary.sh (a SessionStart hook,
# real-installed or local-directory-marketplace-tested alike) -- never
# source, always regenerable from the matching GitHub Release.
/bin/redliner
/bin/redliner.version
/cowork/redliner
/cowork/redliner.version
